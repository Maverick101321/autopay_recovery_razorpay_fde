# Retell AI API key for voice calls
RETELL_API_KEY=

# Phone number override for demo customer accounts (cust_001, cust_002)
DEMO_PHONE=

# Public base URL for webhooks and payment links (e.g. https://xyz.ngrok-free.app)
PUBLIC_BASE_URL=

# SQLite database file path (default: data/autopay.db)
DB_PATH=

# Shared secret for authenticating Retell custom tool webhook calls
TOOL_SHARED_SECRET=

# Enforce x-retell-signature verification on webhooks (default: true)
REQUIRE_WEBHOOK_SIGNATURE=true

# Optional voice ID overrides for English and Hindi agents
RETELL_VOICE_ID_EN=
RETELL_VOICE_ID_HI=

# Twilio trial number imported into Retell, used as caller ID (E.164, e.g. +14157774444)
RETELL_FROM_NUMBER=
